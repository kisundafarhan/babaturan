# GEMINI_API_KEY: Otomatis disediakan oleh Google AI Studio saat runtime.
# Digunakan untuk BABATURAN AI Tutor, Mesin Penerjemah Neural Gemini, Perbandingan Ragam Bahasa, dan Writing Lab.
# Anda TIDAK perlu mengisi GOOGLE_CLOUD_TRANSLATE_API_KEY atau SUNDADIGI_API_KEY agar aplikasi berjalan 100%.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Otomatis diisi oleh AI Studio saat aplikasi di-deploy.
APP_URL="MY_APP_URL"
